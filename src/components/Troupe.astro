---
// La troupe en marche : cinq babouins de profil, posés sur le filet du footer.
// C'est la fin de la piste : on a suivi les traces, voilà ceux qui les ont laissées.
//
// Ce qui fait qu'on reconnaît un babouin, et qu'il faut garder si tu retouches le dessin :
//   - la queue "cassée" : elle monte un peu, puis retombe tout droit ;
//   - la tête basse, un crâne rond bien détaché et un long museau carré qui pointe vers le bas ;
//   - la crinière du mâle : une grosse bosse sur les épaules, et un dos qui descend vers la croupe ;
//   - des pattes longues et fines.
//
// Le dessin est fait de formes simples, réutilisées (<defs>) :
//   male, femelle : le corps sans la tête ni les pattes (la femelle et les jeunes n'ont pas de crinière)
//   tete, queue   : communs à tous
//   pas-a, pas-b  : deux positions de pattes, pour que la troupe ne soit pas un tampon répété
//   petit         : le jeune porté sur le dos
// Chaque babouin est un <g> : translate(x y) le place, scale() donne sa taille.
// Pour que les pattes restent sur le sol, y = 89,2 × (1 - taille).
//
// Règles : des silhouettes pleines, une seule couleur (celle du texte discret), aucun détail
// (pas d'œil, pas de sourire), tout le monde marche vers la droite, une seule troupe par page.
const GROUND = 89.2;

const members = [
  { x: 0, size: 0.55, body: 'femelle', step: 'b' },
  { x: 66, size: 0.88, body: 'femelle', step: 'a' },
  { x: 184, size: 0.85, body: 'femelle', step: 'b', carries: true },
  { x: 296, size: 0.6, body: 'femelle', step: 'a' },
  { x: 378, size: 1, body: 'male', step: 'b' },
];
---

<div class="container troupe" aria-hidden="true">
  <svg viewBox="0 0 502 89.5" focusable="false">
    <defs>
      <g id="troupe-tete" stroke="none">
        <circle cx="95" cy="37.5" r="8.6"></circle>
        <rect x="95" y="36.5" width="22" height="10.5" rx="4.2" transform="rotate(25 95 38)"></rect>
      </g>
      <g id="troupe-male" stroke="none">
        <ellipse cx="67" cy="43" rx="17" ry="18"></ellipse>
        <ellipse cx="34" cy="48.5" rx="11.5" ry="11"></ellipse>
        <path d="M33 37.5C45 36 55 31 64 25.5L74 60C62 59.5 50 53.5 38 59Z"></path>
        <path d="M78 28C83 27 88 28.5 91 30L97 45C93 50 86 55 78 58Z"></path>
      </g>
      <g id="troupe-femelle" stroke="none">
        <ellipse cx="68" cy="46" rx="13.5" ry="14.5"></ellipse>
        <ellipse cx="34" cy="48.5" rx="11.5" ry="11"></ellipse>
        <path d="M33 37.5C45 37 56 34.5 65 32L74 60C62 59.5 50 53.5 38 59Z"></path>
        <path d="M76 33C82 31 87 30 91 30.5L97 45C93 50 86 55 78 58Z"></path>
      </g>
      <path id="troupe-queue" fill="none" stroke-width="2.6" d="M25 42C22 37 19.5 31 17 30C14.5 29.2 13.6 32 13.8 36L15 60"></path>
      <g id="troupe-pas-a" fill="none" stroke-width="4">
        <path d="M76 58L84 87L88.5 87"></path>
        <path d="M69 59L64 87L68.5 87"></path>
        <path stroke-width="4.4" d="M35 55L43 67L39 80L40 87L45 87"></path>
        <path stroke-width="4.4" d="M30 54L30 67L22 80L23 87L27.5 87"></path>
      </g>
      <g id="troupe-pas-b" fill="none" stroke-width="4">
        <path d="M76 58L78 87L82.5 87"></path>
        <path d="M69 59L67 72L69 87L73.5 87"></path>
        <path stroke-width="4.4" d="M35 55L40 67L35 80L36 87L41 87"></path>
        <path stroke-width="4.4" d="M30 54L35 66L29 79L30 87L34.5 87"></path>
      </g>
      <path
        id="troupe-petit"
        stroke="none"
        d="M40 37C40 29.5 44 26 48.5 27C49.5 22.5 55 21.5 57.5 25C59 28 57.5 30.5 55 31.5C57 33.5 58 35.5 58 37Z"
      ></path>
    </defs>

    {
      members.map(({ x, size, body, step, carries }) => (
        <g transform={`translate(${x} ${(GROUND * (1 - size)).toFixed(1)}) scale(${size})`}>
          <use href={`#troupe-${body}`} />
          <use href="#troupe-tete" />
          <use href="#troupe-queue" />
          <use href={`#troupe-pas-${step}`} />
          {carries && <use href="#troupe-petit" />}
        </g>
      ))
    }
  </svg>
</div>

<style>
  /* Rien sous le dessin : les pattes touchent le filet du haut du footer. */
  .troupe {
    padding-top: var(--space-lg);
    pointer-events: none;
  }

  svg {
    display: block;
    width: min(100%, 28rem);
    height: auto;
    margin-left: auto;
    color: var(--color-text-muted);
    fill: currentColor;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
