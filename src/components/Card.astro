---
// Bloc de contenu : un filet, un titre, un texte.
//   layout (optionnel) : "stack" empile titre et texte (par défaut),
//                        "row" place le titre à gauche et le texte à droite sur grand écran.
// Pour des étapes numérotées ou des dates, voir Piste.astro.
interface Props {
  title: string;
  layout?: 'stack' | 'row';
}

const { title, layout = 'stack' } = Astro.props;
---

<div class:list={['card', layout]}>
  <h3>{title}</h3>
  <div class="body"><slot /></div>
</div>

<style>
  .card {
    height: 100%;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-ink);
  }

  h3 {
    margin-bottom: var(--space-sm);
  }

  .body {
    color: var(--color-text-muted);
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (min-width: 48rem) {
    .row {
      display: grid;
      grid-template-columns: 0.42fr 1fr;
      gap: var(--space-xl);
      padding-block: var(--space-lg);
    }

    .row .body {
      font-size: var(--text-lg);
    }
  }
</style>
