---
// Bloc de contenu : un filet, un titre, un texte.
//   step   (optionnel) : numéro d'étape, affiché au-dessus du titre (01, 02...).
//   layout (optionnel) : "stack" empile titre et texte (par défaut),
//                        "row" place le titre à gauche et le texte à droite sur grand écran.
interface Props {
  title: string;
  step?: number;
  layout?: 'stack' | 'row';
}

const { title, step, layout = 'stack' } = Astro.props;
---

<div class:list={['card', layout]}>
  <div>
    {step && <span class="step" aria-hidden="true">{String(step).padStart(2, '0')}</span>}
    <h3>{title}</h3>
  </div>
  <div class="body"><slot /></div>
</div>

<style>
  .card {
    height: 100%;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-ink);
  }

  .step {
    display: block;
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  h3 {
    margin-bottom: var(--space-sm);
  }

  .body {
    color: var(--color-text-muted);
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (min-width: 48rem) {
    .row {
      display: grid;
      grid-template-columns: 0.42fr 1fr;
      gap: var(--space-xl);
      padding-block: var(--space-lg);
    }

    .row .body {
      font-size: var(--text-lg);
    }
  }
</style>
